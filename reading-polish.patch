+  margin-inline-start: auto;
+  opacity: 0.8;
+}
+.pdf-reflow-reveal[hidden] {
+  display: none;
+}
+.pdf-reflow-end-navigation {
+  display: flex;
+  gap: 12px;
+  justify-content: space-between;
+  align-items: center;
+  font-size: 13px;
+  margin-block: 24px;
+}
+.pdf-reflow-dock .pdf-reflow-pagination {
+  position: static;
+  display: none;
+  flex: 0 0 100%;
+  opacity: 1;
+  visibility: visible;
+  transform: none;
+  transition: none;
+  padding: 8px 0 0;
+  border-top: 1px solid var(--color-base-300);
+  flex-wrap: wrap;
+  justify-content: center;
+}
+.pdf-reflow-dock .pdf-reflow-pagination[data-visible='true'] {
+  display: flex;
+}
+.pdf-reflow-pagination input {
+  width: 65px;
+  text-align: center;
+}
+@media (max-height: 550px) {
+  .pdf-reflow-notice {
+    display: none;
+  }
+  .pdf-reflow-controls {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px;
+  }
+  .pdf-reflow-spacing {
+    margin: 0;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .pdf-reflow-toolbar,
+  .pdf-reflow-pagination {
+    transition: none;
+  }
+}
+html[data-eink='true'] .pdf-reflow-toolbar,
+html[data-eink='true'] .pdf-reflow-pagination {
+  transition: none;
+}
+html[data-eink='true'] .pdf-reflow-controls {
+  box-shadow: none;
+}
+html[data-eink='true'] .pdf-reflow-reader button:not(.pdf-reflow-player-host *):disabled {
+  opacity: 1;
+  color: var(--color-base-content);
+  border-style: dashed;
+}
+
+/* The original player occupies real footer height, never overlays the article.
+   Its sheet stays in this overlay's stacking context and uses its own styling. */
+.pdf-reflow-player-host {
+  flex: 0 0 100%;
+  min-width: 0;
+  font-family: var(--font-sans);
+}
+.pdf-reflow-player-host:empty {
+  display: none;
+}
+
+/* Read-aloud transport stays reachable when the reading chrome is hidden. */
+.pdf-reflow-tts {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 6px;
+}
+.pdf-reflow-tts button {
+  pointer-events: auto;
+  box-shadow: 0 2px 12px rgb(0 0 0 / 0.12);
+  font-size: 13px;
+}
+.pdf-reflow-page mark[data-reflow-tts] {
+  color: inherit;
+  background: color-mix(in srgb, var(--color-primary) 24%, var(--color-base-100));
+  border-radius: 3px;
+  box-decoration-break: clone;
+  -webkit-box-decoration-break: clone;
+  scroll-margin-block: calc(96px + var(--safe-top)) 24px;
+}
+html[data-eink='true'] .pdf-reflow-page mark[data-reflow-tts] {
+  background: transparent;
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+}
+html[data-eink='true'] .pdf-reflow-tts button {
+  box-shadow: none;
+}
