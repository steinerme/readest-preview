+    -1,
+    NaN,
+    Infinity,
+    0.7,
+    2,
+    999,
+  ])('clamps velocity %s to a deliberate duration', (v) => {
+    expect(getDialogSwipeCloseDurationMs(v)).toBeGreaterThanOrEqual(140);
+    expect(getDialogSwipeCloseDurationMs(v)).toBeLessThanOrEqual(260);
+  });
+});
