+  pointer-events: auto;
+  transform: translateY(0);
+  transition-delay: 0s;
+}
+.pdf-reflow-reveal {
+  position: absolute;
+  z-index: 1;
+  bottom: calc(8px + var(--safe-bottom));
+  inset-inline-end: 16px;
+  opacity: 0.8;
+}
+.pdf-reflow-reveal[hidden] {
+  display: none;
+}
+.pdf-reflow-end-navigation {
+  display: flex;
+  gap: 12px;
+  justify-content: space-between;
+  align-items: center;
+  font-size: 13px;
+  margin-block: 24px;
+}
+.pdf-reflow-pagination {
+  bottom: 0;
+  transform: translateY(8px);
+  padding: 10px 14px calc(12px + var(--safe-bottom));
+  border-top: 1px solid var(--color-base-300);
+  flex-wrap: wrap;
