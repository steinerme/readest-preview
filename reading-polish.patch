diff --git a/apps/readest-app/src/styles/dialog-polish.css b/apps/readest-app/src/styles/dialog-polish.css
new file mode 100644
index 0000000..3af3154
--- /dev/null
+++ b/apps/readest-app/src/styles/dialog-polish.css
@@ -0,0 +1,65 @@
+/* Scoped to Dialog: do not alter dropdowns, popups, or other DaisyUI modals. */
+.reading-dialog {
+  transition:
+    visibility 0s linear 300ms,
+    opacity 220ms ease-out;
+}
+
+.reading-dialog[open] {
+  visibility: visible;
+  opacity: 1;
+  transition-delay: 0s;
+}
+
+.reading-dialog:not([open]) {
+  visibility: hidden;
+  opacity: 0;
+  pointer-events: none;
+}
+
+.reading-dialog > .modal-box {
+  opacity: 0;
+  translate: 0 0;
+  transition:
+    translate 280ms cubic-bezier(0.22, 1, 0.36, 1),
+    scale 280ms cubic-bezier(0.22, 1, 0.36, 1),
+    opacity 220ms ease-out;
+}
+
+.reading-dialog[open] > .modal-box {
+  opacity: 1;
+  translate: 0 0;
+  scale: 1;
+}
+
+@media (max-width: 639px), (max-height: 639px) {
+  .reading-dialog > .modal-box {
+    translate: 0 14px;
+    scale: 1;
+  }
+}
+
+@media (min-width: 640px) and (min-height: 640px) {
+  .reading-dialog > .modal-box {
+    translate: 0 0;
+    scale: 0.98;
+  }
+}
+
+.reading-dialog[open] > .modal-box {
+  translate: 0 0;
+  scale: 1;
+}
+
+/* Reset scoped transitions so hidden-state visibility remains DaisyUI-compatible. */
+@media (prefers-reduced-motion: reduce) {
+  .reading-dialog,
+  .reading-dialog > .modal-box {
+    transition: none;
+  }
+}
+
+:root[data-eink='true'] .reading-dialog,
+:root[data-eink='true'] .reading-dialog > .modal-box {
+  transition: none;
+}
diff --git a/apps/readest-app/src/styles/library-polish.css b/apps/readest-app/src/styles/library-polish.css
new file mode 100644
index 0000000..9961e02
--- /dev/null
+++ b/apps/readest-app/src/styles/library-polish.css
@@ -0,0 +1,129 @@
+/* Scoped bookshelf polish: theme-aware, dimension-stable and low-motion. */
+.library-polish {
+  background-color: transparent;
+}
+
+.library-polish-header {
+  background-color: var(--color-base-100);
+  border-bottom: 1px solid color-mix(in oklab, var(--color-base-content) 8%, transparent);
+}
+
+.library-polish-header .library-polish-search-shell {
+  border-radius: 0.875rem;
+}
+
+.library-polish-header .library-polish-search {
+  border: 1px solid color-mix(in oklab, var(--color-base-content) 9%, transparent);
+  background-color: color-mix(in oklab, var(--color-base-200) 72%, var(--color-base-100));
+  color: var(--color-base-content);
+}
+
+.library-polish-header .library-polish-search::placeholder {
+  color: color-mix(in oklab, var(--color-base-content) 54%, transparent);
+}
+
+.library-polish-header .library-polish-search-shell:focus-within {
+  outline: 2px solid color-mix(in oklab, var(--color-base-content) 28%, transparent);
+  outline-offset: 2px;
+}
+
+.library-polish-header button.library-polish-control {
+  color: color-mix(in oklab, var(--color-base-content) 76%, transparent);
+}
+
+.library-polish-header button.library-polish-control:hover {
+  color: var(--color-base-content);
+  background-color: color-mix(in oklab, var(--color-base-content) 7%, transparent);
+}
+
+.library-polish-header button:focus-visible,
+.library-polish .bookshelf-import-item button:focus-visible {
+  outline: 2px solid color-mix(in oklab, var(--color-base-content) 42%, transparent);
+  outline-offset: 2px;
+}
+
+.library-polish .bookitem-main {
+  border: 1px solid color-mix(in oklab, var(--color-base-content) 10%, transparent);
+  background-color: var(--color-base-200);
+}
+
+.library-polish .bookitem-main:not(.library-book-cover-spined) {
+  border-radius: 0.5rem;
+}
+
+.library-polish .bookitem-main.library-book-cover-spined {
+  border-radius: 0;
+}
+
+.library-polish .book-item .library-book-title {
+  color: var(--color-base-content);
+}
+
+.library-polish .book-item p,
+.library-polish .book-item .text-neutral-content {
+  color: color-mix(in oklab, var(--color-base-content) 68%, transparent);
+}
+
+.library-polish .library-book-selection-scrim {
+  pointer-events: none;
+}
+
+.library-polish .bookshelf-import-item button {
+  border: 1px solid color-mix(in oklab, var(--color-base-content) 12%, transparent);
+  border-radius: 0.5rem;
+  background-color: color-mix(in oklab, var(--color-base-200) 52%, var(--color-base-100));
+}
+
+.library-polish-empty h1 {
+  color: var(--color-base-content);
+}
+
+.library-polish-empty p {
+  color: color-mix(in oklab, var(--color-base-content) 68%, transparent);
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  html:not([data-eink='true']) .library-polish .book-item {
+    transition: transform 120ms ease-out;
+  }
+
+  html:not([data-eink='true']) .library-polish .book-item:active {
+    transform: scale(0.985);
+  }
+
+  html:not([data-eink='true']) .library-book-selection-scrim {
+    transition: opacity 140ms ease-out;
+  }
+
+  html:not([data-eink='true']) .library-polish-header button.library-polish-control {
+    transition:
+      color 140ms ease-out,
+      background-color 140ms ease-out;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .library-polish .book-item,
+  .library-book-selection-scrim,
+  .library-polish-header button.library-polish-control {
+    transition: none;
+  }
+}
+
+html[data-eink='true'] .library-polish .book-item,
+html[data-eink='true'] .library-book-selection-scrim,
+html[data-eink='true'] .library-polish-header button.library-polish-control {
+  transition: none;
+  transform: none;
+}
+
+html[data-eink='true'] .library-polish .library-book-selection-scrim {
+  opacity: 1;
+  background-color: transparent;
+}
+
+html[data-eink='true'] .library-polish .bookitem-main,
+html[data-eink='true'] .library-polish .bookshelf-import-item button {
+  border-color: var(--color-base-content);
+  background-color: var(--color-base-100);
+}
diff --git a/apps/readest-app/src/styles/reader-polish.css b/apps/readest-app/src/styles/reader-polish.css
new file mode 100644
index 0000000..99f9587
--- /dev/null
+++ b/apps/readest-app/src/styles/reader-polish.css
@@ -0,0 +1,89 @@
+/* Scoped reader chrome: no animated layout, no blur over book text.
+   Panels remain mounted/measurable for the floating TTS player's geometry. */
+.reading-chrome {
+  --reading-enter: 260ms;
+  --reading-exit: 180ms;
+  --reading-ease: cubic-bezier(0.22, 1, 0.36, 1);
+  transition-property: opacity, transform, translate;
+  transition-duration: var(--reading-enter);
+  transition-timing-function: var(--reading-ease);
+}
+
+.reading-chrome[data-visible='false'] {
+  transition-duration: var(--reading-exit);
+}
+
+.header-bar.reading-chrome {
+  transform: translateY(0);
+}
+
+.header-bar.reading-chrome[data-visible='false'] {
+  transform: translateY(-8px);
+}
+
+.reading-panel {
+  --reading-enter: 260ms;
+  --reading-exit: 180ms;
+  --reading-ease: cubic-bezier(0.22, 1, 0.36, 1);
+  border-start-start-radius: 24px;
+  border-start-end-radius: 24px;
+  box-shadow: 0 -8px 28px rgb(0 0 0 / 0.06);
+  opacity: 0;
+  visibility: hidden;
+  transform: translateY(16px);
+  transition:
+    transform var(--reading-exit) var(--reading-ease),
+    opacity var(--reading-exit) ease-out,
+    visibility 0s linear var(--reading-exit);
+}
+
+.reading-panel[data-state='open'] {
+  opacity: 1;
+  visibility: visible;
+  transform: translateY(0);
+  transition-duration: var(--reading-enter), var(--reading-enter), 0s;
+  transition-delay: 0s;
+}
+
+.reading-chrome .btn:focus-visible,
+.reading-panel button:focus-visible {
+  outline: 2px solid var(--color-primary);
+  outline-offset: 3px;
+}
+
+.reading-theme-swatch {
+  transition:
+    opacity 140ms ease-out,
+    transform 140ms ease-out;
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  html:not([data-eink='true']) .reading-theme-swatch:active {
+    transform: scale(0.96);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .reading-chrome,
+  .reading-panel,
+  .reading-theme-swatch {
+    transition: none !important;
+  }
+
+  .header-bar.reading-chrome[data-visible='false'],
+  .reading-panel {
+    transform: none;
+  }
+}
+
+html[data-eink='true'] .reading-chrome,
+html[data-eink='true'] .reading-panel,
+html[data-eink='true'] .reading-theme-swatch {
+  transition: none !important;
+  box-shadow: none;
+}
+
+html[data-eink='true'] .header-bar.reading-chrome[data-visible='false'],
+html[data-eink='true'] .reading-panel {
+  transform: none;
+}
