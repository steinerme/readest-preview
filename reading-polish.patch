+vi.mock('@/context/EnvContext', () => ({
+  useEnv: () => ({ appService: { isAndroidApp: mocks.android } }),
+}));
+vi.mock('@/components/command-palette/CommandPaletteProvider', () => ({
+  useCommandPalette: () => ({
+    isOpen: mocks.isOpen,
+    close: mocks.close,
+    query: '',
