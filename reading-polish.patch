+    expect(mocks.close).not.toHaveBeenCalled();
+  });
+  it('does not touch native key interception off Android', () => {
+    mocks.android = false;
+    render(<CommandPalette />);
+    expect(useDeviceControlStore.getState().backKeyIntercepted).toBe(false);
+  });
+});
