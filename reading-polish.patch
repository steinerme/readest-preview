+    expect(bar.getAttribute('data-visible')).toBe('false');
+    expect(bar.getAttribute('aria-hidden')).toBe('true');
+    expect(bar.hasAttribute('inert')).toBe(true);
+  });
 });
 
 describe('HeaderBar sidebar toggle', () => {
diff --git a/apps/readest-app/src/__tests__/components/PdfReflowDialog.test.tsx b/apps/readest-app/src/__tests__/components/PdfReflowDialog.test.tsx
