+    flex-wrap: wrap;
+    gap: 8px;
+  }
+  .pdf-reflow-spacing {
+    margin: 0;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .pdf-reflow-toolbar,
+  .pdf-reflow-pagination {
+    transition: none;
+  }
+}
+html[data-eink='true'] .pdf-reflow-toolbar,
