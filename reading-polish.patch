+}));
+vi.mock('@/helpers/settings', () => ({ saveViewSettings: vi.fn(), saveSysSettings: vi.fn() }));
+vi.mock('@/components/Slider', () => ({ default: () => <input type='range' /> }));
+vi.mock('@/components/Button', () => ({
