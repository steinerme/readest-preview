diff --git a/apps/readest-app/src/store/pdfReflowStore.ts b/apps/readest-app/src/store/pdfReflowStore.ts
new file mode 100644
index 0000000..88f401c
--- /dev/null
+++ b/apps/readest-app/src/store/pdfReflowStore.ts
@@ -0,0 +1,28 @@
+import { create } from 'zustand';
+
+/** A rendering mode in the existing reader, not a second reader/session. */
+export interface PdfReflowSession {
+  page: number;
+  count: number;
+  navigate: (target: number | string) => Promise<void>;
+  revealCitation?: (cfi: string) => Promise<void>;
+  close: () => void;
+  speak: () => Promise<void>;
+  returnToSpeech: () => void;
+}
+interface State {
+  sessions: Record<string, PdfReflowSession>;
+  setSession: (key: string, session: PdfReflowSession) => void;
+  clearSession: (key: string, navigate: PdfReflowSession['navigate']) => void;
+}
+export const usePdfReflowStore = create<State>((set) => ({
+  sessions: {},
+  setSession: (key, session) => set((s) => ({ sessions: { ...s.sessions, [key]: session } })),
+  clearSession: (key, navigate) =>
+    set((s) => {
+      if (s.sessions[key]?.navigate !== navigate) return s;
+      const sessions = { ...s.sessions };
+      delete sessions[key];
+      return { sessions };
+    }),
+}));
diff --git a/apps/readest-app/src/store/ttsPlayerHostStore.ts b/apps/readest-app/src/store/ttsPlayerHostStore.ts
new file mode 100644
index 0000000..e510fc0
--- /dev/null
+++ b/apps/readest-app/src/store/ttsPlayerHostStore.ts
@@ -0,0 +1,22 @@
+import { create } from 'zustand';
+
+/** Visual host only: the reader's TTSControl remains the sole session owner.
+ * A reflow overlay borrows its existing player rather than starting a controller. */
+interface TTSPlayerHostState {
+  hosts: Record<string, HTMLElement>;
+  setHost: (bookKey: string, host: HTMLElement) => void;
+  clearHost: (bookKey: string, host: HTMLElement) => void;
+}
+
+export const useTTSPlayerHostStore = create<TTSPlayerHostState>((set) => ({
+  hosts: {},
+  setHost: (bookKey, host) => set((state) => ({ hosts: { ...state.hosts, [bookKey]: host } })),
+  clearHost: (bookKey, host) =>
+    set((state) => {
+      // A late cleanup must not remove a newer reader's host for the same book.
+      if (state.hosts[bookKey] !== host) return state;
+      const hosts = { ...state.hosts };
+      delete hosts[bookKey];
+      return { hosts };
+    }),
+}));
diff --git a/apps/readest-app/src/styles/dialog-polish.css b/apps/readest-app/src/styles/dialog-polish.css
new file mode 100644
index 0000000..3af3154
--- /dev/null
+++ b/apps/readest-app/src/styles/dialog-polish.css
@@ -0,0 +1,65 @@
+/* Scoped to Dialog: do not alter dropdowns, popups, or other DaisyUI modals. */
+.reading-dialog {
+  transition:
+    visibility 0s linear 300ms,
+    opacity 220ms ease-out;
+}
+
+.reading-dialog[open] {
+  visibility: visible;
+  opacity: 1;
+  transition-delay: 0s;
+}
+
+.reading-dialog:not([open]) {
+  visibility: hidden;
+  opacity: 0;
+  pointer-events: none;
+}
+
+.reading-dialog > .modal-box {
+  opacity: 0;
+  translate: 0 0;
+  transition:
+    translate 280ms cubic-bezier(0.22, 1, 0.36, 1),
+    scale 280ms cubic-bezier(0.22, 1, 0.36, 1),
+    opacity 220ms ease-out;
+}
+
+.reading-dialog[open] > .modal-box {
+  opacity: 1;
+  translate: 0 0;
+  scale: 1;
+}
+
+@media (max-width: 639px), (max-height: 639px) {
+  .reading-dialog > .modal-box {
+    translate: 0 14px;
+    scale: 1;
+  }
+}
+
+@media (min-width: 640px) and (min-height: 640px) {
+  .reading-dialog > .modal-box {
+    translate: 0 0;
+    scale: 0.98;
+  }
+}
+
+.reading-dialog[open] > .modal-box {
+  translate: 0 0;
+  scale: 1;
+}
+
+/* Reset scoped transitions so hidden-state visibility remains DaisyUI-compatible. */
+@media (prefers-reduced-motion: reduce) {
+  .reading-dialog,
+  .reading-dialog > .modal-box {
+    transition: none;
+  }
+}
+
+:root[data-eink='true'] .reading-dialog,
+:root[data-eink='true'] .reading-dialog > .modal-box {
+  transition: none;
+}
