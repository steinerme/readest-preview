+    };
+  }, [
+    bookKey,
+    page,
+    result,
+    view,
+    viewSettings?.enableAnnotationQuickActions,
+    viewSettings?.annotationQuickAction,
+  ]);
+
+  // Reserve the SAME original chrome's measured height. Footer panels are
